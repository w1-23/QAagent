+def _web_asset(name: str) -> str:
+    """按仓库结构定位前端产物，避免依赖 pytest 的当前工作目录。"""
+    here = pathlib.Path(__file__).resolve()
+    for parent in here.parents:
+        candidate = parent / "web" / "assets" / name
+        if candidate.is_file():
+            return candidate.read_text(encoding="utf-8")
+    raise FileNotFoundError(f"web/assets/{name} not found above {here}")
+
+
+def test_preview_renderer_reads_flat_sheetjs_fill():
+    """预览层必须认 SheetJS 读 xlsx 时的扁平填充形态（s.patternType + s.fgColor），
+    否则标注色在浏览器里一块都显示不出来。"""
+    src = _web_asset("session_files.js")
+    assert "cellStyles: true" in src
+    assert "st.patternType" in src and "st.fgColor" in src
+    assert "sf-cell-boxed" in src and "sf-cell-mark" in src
+
+def test_preview_exposes_sheet_tabs_and_issue_jump_targets():
+    """多 Sheet 综合标注的预览契约：页签、问题清单行、跳转锚点三处必须在同一份 JS 里对齐，
+    否则“点问题跳到对应工作表/单元格”只能是设想。"""
+    src = _web_asset("session_files.js")
+    css = _web_asset("session_files.css")
+    # 页签渲染
+    assert "sf-sheet-tab" in src and "sf-sheet-tabs" in src
+    # 问题清单：行必须是可点元素，且带跳转目标
+    assert "sf-issue-row" in src
+    assert "data-ref" in src and "data-sheet" in src
+    # 跳转：切页签 + 定位 + 高亮
+    assert "sf-cell-focus" in src and "sf-cell-focus" in css
+    assert "bindIssueList" in src and "applyPendingFocus" in src
+
+def test_issue_list_sorted_by_severity(tmp_path):
+    """问题清单按严重程度排序（阻断 → 需核查 → 提示），同级别内保持原有行序。"""
+    path = _make(tmp_path / "sev.xlsx", {"S": [
+        ["样本", "处理", "值"],
+        ["S01", "CK", 12.4],
+        ["S02", "CK", 98.7],
+        ["S03", "T1", 13.1],
+    ]})
+    findings = [
+        {"sheet": "S", "check": "constant_field", "field": "处理", "row": 2},
+        {"sheet": "S", "check": "iqr_outlier", "field": "值", "row": 3,
+         "detail": "IQR 上界 30"},
+        {"sheet": "S", "check": "empty_table", "field": "", "row": ""},
+    ]
+    out, stats = annotate_workbook(
+        pathlib.Path(path).read_bytes(), sheet_name="S", header_row=1,
+        findings=findings, row_count=3, column_count=3)
+    wb = load_workbook(_io.BytesIO(out))
+    issues = _issue_rows(wb)
+    severities = [row["严重程度"] for row in issues]
+    assert severities == ["阻断", "需核查", "提示"], severities
+    # 序号仍连续
+    assert [row["序号"] for row in issues] == [1, 2, 3]
+    # 同级别内保持原顺序：唯一「需核查」条目仍是离群那条
+    assert issues[1]["问题类型"] == "离群值"
+
+
+def test_finding_cap_states_what_was_not_listed():
+    """资源上限可以存在，但必须写明清单不完整，不能静默丢弃。"""
+    import pandas as pd
+    from src.research.tools import _audit_frame
+    frame = pd.DataFrame({"甲": list(range(7000)), "乙": list(range(7000)),
+                          "丙": list(range(7000))})
+    findings, _ = _audit_frame(frame, {}, [], [],
+                               ranges={c: {"min": 0, "max": 1} for c in frame.columns})
+    assert len(findings) == 20001
+    notice = findings[-1]
+    assert notice["check"] == "findings_truncated"
+    assert "未列出" in notice["detail"] and "无异常" in notice["detail"]
diff --git a/01_src/src/research/test_deliverable_publish_guard.py b/01_src/src/research/test_deliverable_publish_guard.py
