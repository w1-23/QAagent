+    assert _source_scope("只查本地柑橘文献") == "local"
+    assert _source_scope("只查网页上的柑橘文献") == "web"
+    assert _source_scope("只从本地柑橘文献语料检索关于黄龙病抗性的英文文献") == "local"
+    assert _source_scope("只从网页搜索黄龙病抗性相关论文") == "web"
