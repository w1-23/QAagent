+
+def test_xlsx_dimensions_are_limited_before_materialization(monkeypatch):
+    import src.research.tools as research_tools
+    wb = Workbook()
+    ws = wb.active
+    ws.append([f"c{i}" for i in range(201)])
+    output = io.BytesIO()
