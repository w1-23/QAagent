+    book = Workbook()
+    sheet = book.active
+    sheet.title = title
+    sheet.append(list(_frame().columns))
+    for row in _frame().itertuples(index=False, name=None):
+        sheet.append(list(row))
+    buffer = io.BytesIO()
+    book.save(buffer)
+    return buffer.getvalue()
