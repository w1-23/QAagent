+from __future__ import annotations
+
+import io
+import zipfile
+
+import pandas as pd
+from openpyxl import Workbook
+
+from src.research.context import reset_request_tables, set_request_tables
+from src.research.tools import (
+    _audit_frame,
+    _decode_csv,
+    _json_arg,
+    _load_frame,
+    _metadata_candidate,
+    _normalize_doi,
+    audit_uploaded_data,
+    export_paper_analysis,
