# Citrus QA Agent 环境配置模板 — 复制为 .env 后填写
# 部署到新服务器时，在此配置 API Key（.env 已被 .gitignore 排除，不会进入代码包）

# DeepSeek 主模型（回答/推理/压缩）
DEEPSEEK_API_KEY=
MAIN_BASE_URL=https://api.deepseek.com

# 快模型（意图分类/搜索建议/HyDE，可留空则回退到主模型）
FAST_API_KEY=
FAST_BASE_URL=
FAST_MODEL=deepseek-chat

# 嵌入模型（本地 ONNX，无需 Key）
EMBEDDING_MODEL=intfloat/multilingual-e5-large
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Web 搜索（当前未启用，可留空）
SERPER_API_KEY=
WEB_SEARCH_API_KEY=
