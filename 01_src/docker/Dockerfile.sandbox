# The figure sandbox image.
#
# This image holds only what a plotting script needs: Matplotlib, NumPy, and
# the figure engine. It deliberately does **not** contain the service, the
# database, the corpus, or any credential — a script running here must not
# be able to reach any of them even if the container were misconfigured.
#
# Build:
#   docker build -f 01_src/docker/Dockerfile.sandbox -t citrusqa/sandbox:1.0.0 .
#
# Run (the service does this for you; shown here for the record, one flag per
# line — a single line is in 01_src/docker/README.md §7):
#   docker run --rm
#     --network none --cap-drop ALL --security-opt no-new-privileges
#     --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m
#     --pids-limit 128 --memory 1024m --cpus 1.0 --user 65534:65534
#     --mount type=bind,src=<job>/in,dst=/work/in,readonly
#     --mount type=bind,src=<job>/out,dst=/work/out
#     --entrypoint /usr/bin/timeout citrusqa/sandbox:1.0.0
#     --signal=TERM --kill-after 5s 120s
#     python -I /opt/citrusfig/worker.py --job /work/in/job.json
#
# The entrypoint is overridden with ``timeout`` on purpose. The service passes
# the whole command rather than relying on ENTRYPOINT + CMD, and the wall
# clock budget has to be enforced inside the container: killing the docker
# client does not stop the container.
#
# The signal is TERM, not KILL: with KILL, ``timeout`` dies of the signal it
# sent and the container reports 137 — indistinguishable from an OOM kill, so
# a script that merely looped forever would be reported as out of memory.
# TERM gives the documented 124; ``--kill-after`` still ends a script that
# ignores TERM.

FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1     PYTHONUNBUFFERED=1     MPLBACKEND=Agg     MPLCONFIGDIR=/tmp/mpl

# CJK fonts so Chinese axis labels and titles render as glyphs rather than
# tofu boxes. DejaVu covers Latin; Noto covers Chinese. ``timeout`` comes
# from coreutils, which the base image already has.
RUN apt-get update && apt-get install -y --no-install-recommends         fonts-dejavu-core         fonts-noto-cjk     && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir         "matplotlib>=3.7.0"         "numpy>=1.24"         "pandas>=2.0.0"

# The engine goes in under ``src/figures``, because that is the name its own
# modules import from: ``core.py`` begins with ``from src.figures.spec import
# ...``. A flat ``figures/`` directory made the package unable to import
# itself — every job died on ModuleNotFoundError before the first line of the
# user's script ran, and nothing in the service-side tests could see it.
WORKDIR /opt/citrusfig
COPY 01_src/src/figures/__init__.py /opt/citrusfig/src/figures/__init__.py
COPY 01_src/src/figures/spec.py /opt/citrusfig/src/figures/spec.py
COPY 01_src/src/figures/styling.py /opt/citrusfig/src/figures/styling.py
COPY 01_src/src/figures/core.py /opt/citrusfig/src/figures/core.py
COPY 01_src/src/figures/runtime.py /opt/citrusfig/src/figures/runtime.py
COPY 01_src/src/figures/manifest.py /opt/citrusfig/src/figures/manifest.py
COPY 01_src/src/figures/overrides.py /opt/citrusfig/src/figures/overrides.py
COPY 01_src/src/figures/exporter.py /opt/citrusfig/src/figures/exporter.py
COPY 01_src/src/figures/worker.py /opt/citrusfig/worker.py

ENV PYTHONPATH=/opt/citrusfig

# A non-root user that owns nothing and can write only to the mounted
# output directory.
RUN useradd --create-home --uid 65534 --shell /usr/sbin/nologin sandbox 2>/dev/null || true
USER 65534:65534

ENTRYPOINT ["python", "-I", "/opt/citrusfig/worker.py"]
CMD ["--job", "/work/in/job.json"]
